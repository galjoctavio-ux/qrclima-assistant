{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot privado de contexto QRclima",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "profile_id", "organization_id", "actor_uid", "account_reference", "category", "observed_at", "source", "coverage", "records"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "actor_uid": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "account_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "category": {"enum": ["company", "clients", "concepts", "appointments", "quotations", "documents"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "additionalProperties": false, "required": ["type", "reference"], "properties": {"type": {"enum": ["qrclima_ui", "authorized_connector", "user_document"]}, "reference": {"type": "string", "minLength": 1, "maxLength": 1000}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["state", "scope", "next_cursor"], "properties": {"state": {"enum": ["partial", "complete", "unavailable"]}, "scope": {"type": "string", "minLength": 1, "maxLength": 1000}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000}}},
    "records": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["record_id", "data", "evidence_refs"], "properties": {"record_id": {"type": "string", "minLength": 1, "maxLength": 500}, "data": {"type": "object"}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}}}}
  }
}
