{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caso y recibo de operación QRclima",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "kind", "organization_id", "actor_uid", "state", "explicit_input", "missing_fields", "authorization_ref", "result", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "attempt_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["sale_create_ui", "appointment_create_ui", "finance_read"]},
    "organization_id": {"type": ["string", "null"], "minLength": 1},
    "actor_uid": {"type": ["string", "null"], "minLength": 1},
    "actor_reference": {"type": "string", "minLength": 1, "maxLength": 500},
    "state": {"enum": ["draft", "needs_information", "awaiting_authorization", "executing", "outcome_unknown", "verified", "failed"]},
    "explicit_input": {"type": "object"},
    "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authorization_ref": {"type": ["string", "null"], "minLength": 1},
    "result": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["qrclima_record_id", "record_type", "reread_at", "evidence_refs", "linked_record_ids"],
      "properties": {"qrclima_record_id": {"type": "string", "minLength": 1}, "record_type": {"type": "string", "minLength": 1}, "reread_at": {"type": "string", "format": "date-time"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "linked_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
